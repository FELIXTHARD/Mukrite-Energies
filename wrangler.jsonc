{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mukrite-energies",
  "compatibility_date": "2026-07-12",
  // Static-assets-only Worker: serves the Next.js static export from `out/`.
  "assets": {
    "directory": "./out",
    // `/about` and `/about/` both resolve to `about.html` / `about/index.html`.
    "html_handling": "auto-trailing-slash",
    // Serve Next's exported `404.html` for unknown paths.
    "not_found_handling": "404-page"
  }
}
